MYSQL_ROOT_PASSWORD=public-demo-secret-1-change-before-use
MYSQL_DATABASE=local_life
MYSQL_USER=local_life
MYSQL_PASSWORD=public-demo-secret-2-change-before-use
MYSQL_HOST_PORT=13306

BACKEND_PORT=8080
AGENT_PORT=8000
AGENT_CANARY_PORT=8001
AGENT_HYBRID_CANARY_PORT=8002
KAFKA_HOST_PORT=19092
ELASTICSEARCH_HOST_PORT=19200
PROMETHEUS_HOST_PORT=19090

# Local development placeholders only. Generate strong independent values
# outside version control before any shared or internet-facing deployment.
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ISSUER=local-life-backend
JWT_ACCESS_TTL=PT15M
JWT_REFRESH_TTL=P30D
AUTH_REFRESH_STORE=redis
PAYMENT_CALLBACK_SECRET=replace-with-an-independent-payment-secret
PAYMENT_CALLBACK_TOLERANCE=PT5M
PAYMENT_SIMULATOR_ENABLED=false
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT=20
WRITE_RATE_LIMIT=120
RATE_LIMIT_WINDOW=PT1M

MESSAGING_ENABLED=true
MESSAGING_TRANSPORT=kafka
REVIEW_SYNC_MODE=outbox
FLASH_SALE_ENABLED=true
SEARCH_ENABLED=true
BACKEND_RUNTIME_IMAGE=eclipse-temurin:17-jre

DEEPSEEK_API_KEY=
DOCKER_HTTP_PROXY=
DOCKER_HTTPS_PROXY=
DOCKER_NO_PROXY=localhost,127.0.0.1,backend,redis,qdrant,mysql,kafka,elasticsearch
KNOWLEDGE_SOURCE_AWARE_ENABLED=true
KNOWLEDGE_REVIEW_HYBRID_ENABLED=true
ECOMMERCE_GUIDE_ENABLED=true
AGENT_CONTEXT_MODE=context_pack
AGENT_ORCHESTRATOR_MODE=unified
# Production: react_v1. Rollback/control: fixed_v1. Historical evaluation
# modes require AGENT_EXPERIMENTAL_CONTROL_RUNTIMES_ENABLED=true as a second gate.
AGENT_EXPERIMENTAL_CONTROL_RUNTIMES_ENABLED=false
AGENT_CONTROL_RUNTIME=react_v1
AGENT_REACT_LIVE_ENABLED=true
AGENT_REACT_MAX_ITERATIONS=4
AGENT_REACT_DECISION_TIMEOUT_SECONDS=15
# Temporary rollback for routes whose Harness contracts have not migrated yet.
AGENT_LEGACY_FALLBACK_ENABLED=false
AGENT_EXECUTOR_LEASE_SECONDS=60
# V2 control-plane graph (agent/app/graph). Both default off; V1 remains the
# production path. Enabling BOTH is fail-closed back to V1 at request time.
AGENT_GRAPH_V2_ENABLED=false
AGENT_GRAPH_V2_SHADOW_ENABLED=false
# DAY2 durable checkpoint + real clarification interrupt()/resume() control
# plane. Default false; V1 remains production, V2 live runs only in the
# dedicated acceptance process (requirement #10).
AGENT_GRAPH_V2_DURABLE_ENABLED=true
# Record-only Strategy routing candidate metadata; no execution or extra calls.
AGENT_STRATEGY_SHADOW_ENABLED=false
# Durable read-only Strategy receipt ledger seam; no dispatch wiring in Batch 2a.
AGENT_STRATEGY_RECEIPT_LEDGER_ENABLED=false
AGENT_STRATEGY_RECEIPT_LEDGER_TTL_SECONDS=86400
AGENT_STRATEGY_RECEIPT_LEDGER_LEASE_SECONDS=30
AGENT_STRATEGY_RECEIPT_LEDGER_RECOVERY_MAX=1
# DAY2 test-only deterministic fault point (requirement #8): terminates the
# process after a live search step's output AND TaskState receipt are persisted
# but before the next graph checkpoint is confirmed. Values: "" | "after_executor_receipt".
AGENT_GRAPH_V2_FAULT_POINT=
AGENT_REQUEST_DEADLINE_SECONDS=45
EVIDENCE_CRITIC_ENABLED=false
EVIDENCE_CRITIC_TIMEOUT_SECONDS=12
EVIDENCE_CRITIC_SHUTDOWN_TIMEOUT_SECONDS=5
AGENT_TRANSACTION_ENABLED=false
COMMERCE_DEMO_ENABLED=false
COMMERCE_DEMO_PAYMENT_SIMULATION_ENABLED=false
COMMERCE_DEMO_COOKIE_SECURE=false
TRANSACTION_CONFIRMATION_TTL_SECONDS=300
PRODUCT_COLLECTION_NAME=product_catalog
PRODUCT_RETRIEVAL_MODE=elasticsearch
SHOPPING_STATE_AUTHORITY=v2
PRODUCT_VECTOR_BACKEND=qdrant
PRODUCT_VECTOR_TIMEOUT_SECONDS=3
PRODUCT_TITLE_RERANKER_ENABLED=false
PRODUCT_TITLE_RERANKER_CANDIDATE_LIMIT=20
PRODUCT_TITLE_RERANKER_TIMEOUT_SECONDS=6
# Shared read-only knowledge MCP; legacy behavior remains the default.
PRODUCT_KNOWLEDGE_ENABLED=false
PRODUCT_KNOWLEDGE_MCP_URL=http://127.0.0.1:18791/mcp
PRODUCT_KNOWLEDGE_TIMEOUT_SECONDS=10
# Local knowledge demo uses disabled / 800; omit overrides elsewhere.
AGENT_FINAL_ANSWER_THINKING=provider_default
# AGENT_FINAL_ANSWER_MAX_TOKENS=800
WEB_QUERY_INTAKE_ENABLED=true
WEB_QUERY_INTAKE_PATH=.runtime/web-query-intake/queries.sqlite3
WEB_QUERY_INTAKE_RETENTION_DAYS=90
WEB_QUERY_INTAKE_WRITE_TIMEOUT_SECONDS=0.25
# 先快后完整 fast-preview path for used-phone web queries. Off by default so JSON
# flows and existing tests keep their exact behavior; the live demo enables it.
# USED_PHONE_FAST_PREVIEW_ENABLED=true
# USED_PHONE_FAST_PREVIEW_CACHE_MAX_ENTRIES=256
# Bump when the frozen used-phone catalog/dataset changes so previews never reuse
# stale candidates after a data refresh.
# USED_PHONE_FAST_PREVIEW_CATALOG_REVISION=used-phone-catalog-v1-2026-08
# Derived values from the current 439-row catalog. They are labeled "模拟参考价 / AI 合成，非真实报价".
# disabled: ignore; display_only: show only; budget_and_ranking: explicitly allow budget filtering/ranking.
USED_PHONE_SYNTHETIC_PRICE_POLICY=disabled
USED_PHONE_SYNTHETIC_PRICE_DIR=datasets/current/used-phone

K6_VUS=10
K6_DURATION=30s
ROCKETMQ_NAMESERVER=localhost:9876
ROCKETMQ_FLASH_SALE_TOPIC=flash-sale-orders-v1
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=local_life
RABBITMQ_PASSWORD=local_rabbit_password
