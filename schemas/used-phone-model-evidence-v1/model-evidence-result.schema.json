{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.example/schemas/used-phone-model-evidence-v1/model-evidence-result.schema.json",
  "title": "Used-phone Model Evidence Result V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "policyVersion",
    "observation",
    "findings",
    "registrySha256",
    "pilotBindingSha256",
    "trace",
    "networkCalls",
    "modelCalls",
    "stopReason"
  ],
  "properties": {
    "schemaVersion": {"const": "used-phone-model-evidence-result-v1"},
    "policyVersion": {"const": "used-phone-model-evidence-policy-v1"},
    "observation": {"$ref": "#/$defs/titleObservation"},
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/finding"}
    },
    "registrySha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "pilotBindingSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "trace": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "networkCalls": {"const": 0},
    "modelCalls": {"const": 0},
    "stopReason": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonicalModelClaim", "family", "matchedText", "modelText", "ruleId", "span"],
      "properties": {
        "canonicalModelClaim": {"type": "string", "minLength": 3},
        "family": {"type": "string", "minLength": 1},
        "matchedText": {"type": "string", "minLength": 1},
        "modelText": {"type": "string", "minLength": 1},
        "ruleId": {"type": "string", "minLength": 1},
        "span": {
          "type": "array",
          "prefixItems": [{"type": "integer", "minimum": 0}, {"type": "integer", "minimum": 1}],
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "titleObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "rulesetVersion", "itemId", "title", "titleSha256",
        "catalogBrand", "catalogBrandFamily", "status", "authority",
        "listingIdentityVerified", "claims"
      ],
      "properties": {
        "schemaVersion": {"const": "title-claim-observation-v1"},
        "rulesetVersion": {"const": "used-phone-title-model-claim-rules-v2"},
        "itemId": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "titleSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "catalogBrand": {"type": "string"},
        "catalogBrandFamily": {"type": "string", "minLength": 1},
        "status": {"enum": ["TITLE_CLAIM_SINGLE", "TITLE_CLAIM_AMBIGUOUS", "TITLE_CLAIM_UNRESOLVED"]},
        "authority": {"const": "SELLER_TITLE_CLAIM_ONLY"},
        "listingIdentityVerified": {"const": false},
        "claims": {"type": "array", "items": {"$ref": "#/$defs/claim"}}
      }
    },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider", "publisher", "sourceRole", "status", "url", "stableDocumentId",
        "licenseProfile", "lastVerifiedDate", "automatedExtractionAuthorized",
        "snapshotRedistributionAuthorized"
      ],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "publisher": {"type": "string", "minLength": 1},
        "sourceRole": {"enum": ["OFFICIAL", "INDEPENDENT_TEST"]},
        "status": {"type": "string", "minLength": 1},
        "url": {"type": "string", "pattern": "^https://"},
        "stableDocumentId": {"type": "string", "minLength": 1},
        "licenseProfile": {"type": "string", "minLength": 1},
        "lastVerifiedDate": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "automatedExtractionAuthorized": {"const": false},
        "snapshotRedistributionAuthorized": {"const": false}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceGapKey", "status", "authority", "canonicalModelClaim",
        "sourceLocators", "reasonCode", "canProve", "cannotProve"
      ],
      "properties": {
        "evidenceGapKey": {"enum": ["official_model_reference", "independent_performance_reference", "physical_device_condition"]},
        "status": {"enum": ["REFERENCE_AVAILABLE", "UNKNOWN", "CONFLICT"]},
        "authority": {"enum": ["SELLER_TITLE_CLAIM_ONLY", "OFFICIAL_MODEL_REFERENCE", "INDEPENDENT_MODEL_TEST_REFERENCE", "NO_TRUSTED_DEVICE_BINDING"]},
        "canonicalModelClaim": {"type": ["string", "null"]},
        "sourceLocators": {"type": "array", "items": {"$ref": "#/$defs/locator"}},
        "reasonCode": {"type": "string", "minLength": 1},
        "canProve": {"type": "array", "items": {"type": "string"}},
        "cannotProve": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
