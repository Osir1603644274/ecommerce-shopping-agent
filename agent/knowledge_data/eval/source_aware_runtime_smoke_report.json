      "chunks": [
        {
          "chunkId": "policy_doc:privacy-and-recommendation:data-minimization",
          "sourceType": "policy_doc",
          "sourceId": "privacy-and-recommendation",
          "title": "用户行为数据与个性化推荐说明 - 个人信息处理应遵循最小必要原则",
          "shopId": null,
          "score": 0.7713563,
          "contentPreview": "用户行为数据与个性化推荐说明\n个人信息处理应遵循最小必要原则\n平台处理用户信息时，应当围绕明确、合理的目的进行，尽量使用实现功能所必要的最少数据。比如“猜你喜欢”通常需要用户与商户的交互记录，但不一定需要身份证号、通讯录等与推荐目的无关的信息。\n\n适合回答的问题：\n\n- 推荐系统为什么不应该收集过多信息？\n- 用户行为数据和敏感个人信息有什么区别？\n- 平台做推荐时可以只用哪些必要信息？"
        },
        {
          "chunkId": "policy_doc:privacy-and-recommendation:recommendation-data-use",
          "sourceType": "policy_doc",
          "sourceId": "privacy-and-recommendation",
          "title": "用户行为数据与个性化推荐说明 - 个性化推荐需要说明数据用途",
          "shopId": null,
          "score": 0.7516687,
          "contentPreview": "用户行为数据与个性化推荐说明\n个性化推荐需要说明数据用途\n本地生活平台如果使用浏览、收藏、评分、点击等用户行为生成“猜你喜欢”，应当向用户说明数据用途和基本处理方式。推荐功能不应以超出必要范围的方式收集与推荐无关的信息。\n\n适合回答的问题：\n\n- 为什么猜你喜欢需要用户历史行为？\n- 平台可以用我的浏览记录做推荐吗？\n- 推荐功能应该向用户说明什么？"
        },
        {
          "chunkId": "policy_doc:privacy-and-recommendation:automated-decision-explanation",
          "sourceType": "policy_doc",
          "sourceId": "privacy-and-recommendation",
          "title": "用户行为数据与个性化推荐说明 - 自动化决策和推荐应当可解释",
          "shopId": null,
          "score": 0.7335632,
          "contentPreview": "用户行为数据与个性化推荐说明\n自动化决策和推荐应当可解释\n如果平台利用个人信息进行自动化决策或个性化推荐，应当关注透明度和用户权益。项目中的推荐解释可以展示推荐原因、触发推荐的历史商户、推荐分和可选距离，让用户知道为什么看到某个推荐。\n\n适合回答的问题：\n\n- 推荐系统为什么要展示推荐原因？\n- 用户为什么会看到某家店？\n- 自动化推荐需要注意哪些用户权益？"
        }
      ]
    }
