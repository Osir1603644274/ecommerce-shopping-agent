{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.example/schemas/retrieval-judgment-pool-config-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dataset", "field_mapping", "retrievers", "fusion", "reranker", "selection", "safety"],
  "properties": {
    "execution_profile": {"enum": ["native_v1", "external_models_v1"]},
    "schema_version": {"const": "retrieval-judgment-pool-config-v1"},
    "dataset": {
      "type": "object", "additionalProperties": false,
      "required": ["dataset_id", "revision", "visibility", "contains_labels"],
      "properties": {
        "dataset_id": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "visibility": {"const": "public"},
        "contains_labels": {"const": false}
      }
    },
    "field_mapping": {
      "type": "object", "additionalProperties": false,
      "required": ["query_id", "query_text", "query_variants", "query_structured", "document_id", "document_entity_type", "document_source", "document_text_fields", "blind_display_fields"],
      "properties": {
        "query_id": {"type":"string","minLength":1}, "query_text": {"type":"string","minLength":1},
        "query_variants": {"type":"string","minLength":1}, "query_structured": {"type":"string","minLength":1},
        "document_id": {"type":"string","minLength":1}, "document_entity_type": {"type":"string","minLength":1},
        "document_source": {"type":"string","minLength":1},
        "document_text_fields": {"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
        "blind_display_fields": {"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}}
      }
    },
    "retrievers": {
      "type": "array", "minItems": 3,
      "items": {
        "type":"object",
        "required":["retriever_id","kind","depth","model","revision"],
        "properties": {
          "retriever_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9._-]{0,63}$"},
          "kind":{"enum":["lexical_bm25f","char_ngram","semantic_hash","structured","external"]},
          "family":{"enum":["lexical","character","dense"]},
          "depth":{"type":"integer","minimum":1,"maximum":1000},
          "model":{"type":"string","minLength":1}, "revision":{"type":"string","minLength":1},
          "field_weights":{"type":"object","minProperties":1,"additionalProperties":{"type":"number","exclusiveMinimum":0}},
          "ngram_min":{"type":"integer","minimum":1,"maximum":4}, "ngram_max":{"type":"integer","minimum":1,"maximum":6},
          "dimensions":{"type":"integer","minimum":32,"maximum":4096}
        },
        "additionalProperties": false,
        "allOf": [
          {"if":{"properties":{"kind":{"const":"lexical_bm25f"}}},"then":{"required":["field_weights"]}},
          {"if":{"properties":{"kind":{"const":"char_ngram"}}},"then":{"required":["ngram_min","ngram_max"]}},
          {"if":{"properties":{"kind":{"const":"semantic_hash"}}},"then":{"required":["dimensions"]}}
        ]
      }
    },
    "fusion": {"type":"object","additionalProperties":false,"required":["method","k"],"properties":{"method":{"const":"rrf"},"k":{"type":"integer","minimum":1,"maximum":1000}}},
    "reranker": {"type":"object","additionalProperties":false,"required":["kind","model","revision","pair_budget_per_query"],"properties":{"kind":{"enum":["deterministic_pair_overlap","external_scores"]},"model":{"type":"string","minLength":1},"revision":{"type":"string","minLength":1},"pair_budget_per_query":{"type":"integer","minimum":1,"maximum":1000}}},
    "selection": {
      "type":"object","additionalProperties":false,
      "required":["raw_depth_per_retriever","top_k_per_retriever","unique_quota","disagreement_quota","hard_negative_quota","reranker_quota","random_tail_quota","final_pool_budget_per_query"],
      "properties": {
        "raw_depth_per_retriever":{"type":"integer","minimum":1}, "top_k_per_retriever":{"type":"integer","minimum":1},
        "unique_quota":{"type":"integer","minimum":0}, "disagreement_quota":{"type":"integer","minimum":0},
        "hard_negative_quota":{"type":"integer","minimum":0}, "reranker_quota":{"type":"integer","minimum":0},
        "random_tail_quota":{"type":"integer","minimum":0}, "final_pool_budget_per_query":{"type":"integer","minimum":1}
      }
    },
    "safety": {
      "type":"object","additionalProperties":false,
      "required":["output_label","outside_pool_is_negative","read_qrels","read_sealed_or_hidden","production_release_allowed"],
      "properties": {
        "output_label":{"const":"UNJUDGED"}, "outside_pool_is_negative":{"const":false},
        "read_qrels":{"const":false}, "read_sealed_or_hidden":{"const":false},
        "production_release_allowed":{"const":false}
      }
    }
  }
}
